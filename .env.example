# Copy to .env.local; keep preview builds untracked.
PUBLIC_DEPLOY_ENV=preview
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_GOOGLE_SITE_VERIFICATION=

